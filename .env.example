# OpenAI Configuration
OPENAI_API_KEY=sk-your_openai_key_here

# Gemini Configuration (Optional - used as backup)
GEMINI_API_KEY=gsk_your_gemini_key_here

# Claude Configuration (Optional - used as secondary backup)
ANTHROPIC_API_KEY=sk_ant_your_claude_key_here

# Deployment
RENDER_EXTERNAL_URL=https://mai-pot-api.onrender.com
PORT=5000

# Keep-Alive
KEEP_ALIVE_INTERVAL=300

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=3600

# Response Configuration
MAX_TOKENS=1500
TEMPERATURE=0.7
TIMEOUT=30

# Logging
LOG_LEVEL=INFO
LOG_FILE=app.log

# CORS
CORS_ORIGINS=*

# Development
DEBUG=False
